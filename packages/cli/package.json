{
  "name": "pixelpact",
  "version": "0.3.2",
  "type": "module",
  "description": "Measure the UI a coding agent just built against the reference page, and get numbers back",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "mcp",
    "visual-testing",
    "cli",
    "design-system",
    "playwright",
    "css",
    "contract"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jamalkamaladdin/pixelpact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamalkamaladdin/pixelpact.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/jamalkamaladdin/pixelpact/issues",
  "bin": {
    "pixelpact": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pixelpact-core": "workspace:^",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "playwright": ">=1.45.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "playwright": "^1.63.0"
  }
}
